# Copy to .env.local for development. Configure the same values in your host.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://woff.space
# Server only: bounded file links, cleanup and billing. Required for Free delivery too.
# Never use NEXT_PUBLIC_ for this key.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Accounts and paid checkout stay gated until the corresponding setup is tested.
WOFF_ACCOUNTS_ENABLED=true
WOFF_EMAIL_DELIVERY_VERIFIED=false
WOFF_STORAGE_CAPACITY_VERIFIED=false
WOFF_BILLING_ENABLED=false

# Lemon Squeezy hosted checkout. Keep test keys/data in an isolated local app/database.
# Cloud staging is optional. Use Test keys with TEST_MODE=true for simulated payments.
# Real charges require live keys, TEST_MODE=false and verified paid storage capacity.
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_TEST_MODE=true
